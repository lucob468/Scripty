local function refreshHUD(dt)
	HUD.clock += dt
	if HUD.clock < 0.18 or not HUD.status then
		return
	end
	HUD.clock = 0
	local origin = getOrigin()
	local distance = flatDistance(STATE.position, origin)
	local mode = "AUTONOMOUS"
	if STATE.manual then
		mode = "SHADOW / IMITATION"
	elseif not STATE.running then
		mode = "PAUSED"
	elseif STATE.steps < CONFIG.WarmupSteps then
		mode = "BOOTSTRAP / DEMO"
	end
	HUD.status.Text = string.format("%s · %s", mode, STATE.training and "GRADIENT" or "READY")
	HUD.status.TextColor3 = STATE.lastError and Color3.fromRGB(255, 156, 156) or Color3.fromRGB(201, 247, 91)
	HUD.detail.Text = string.format("step %d · loss %.3f · λ %.2f · edits %d", STATE.steps, STATE.loss or 0, STATE.imitationLambda, STATE.mutations)
	HUD.telemetry.Text = string.format("AGENT %03d, %03d · %.1f studs/s\nRADIUS %.1f / %d · VALUE %+.2f\nCOMMAND %s · REPLAY %d", math.floor(STATE.position.X), math.floor(STATE.position.Z), STATE.speed, distance, CONFIG.Radius, STATE.searchValue or 0, STATE.lastMutationDetail and STATE.lastMutationDetail.command or "Hover", Replay.size)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.RightShift and HUD.screen then
		HUD.screen.Enabled = not HUD.screen.Enabled
	elseif input.KeyCode == Enum.KeyCode.G then
		nextGoal()
	end
end)

RunService.Heartbeat:Connect(function(dt)
	pcall(tickBehaviors, dt)
	if STATE.manual then
		pcall(manualCapture, dt)
	elseif STATE.running then
		STATE.decisionClock += dt
		if STATE.decisionClock >= CONFIG.DecideEvery then
			STATE.decisionClock = 0
			pcall(finalizePending)
			local ok, err = pcall(decide)
			if not ok then
				STATE.lastError = tostring(err)
			end
		end
		local flightOk, flightErr = pcall(applyFlight, dt)
		if not flightOk then
			STATE.lastError = tostring(flightErr)
		end
	else
		STATE.desiredVelocity = Vector3.zero
		pcall(applyFlight, dt)
	end
	STATE.trainClock += dt
	if STATE.trainClock >= CONFIG.TrainEvery and Replay.size >= 2 and not STATE.training and not STATE.manual then
		STATE.trainClock = 0
		local ok, err = pcall(trainBatch)
		if not ok then
			STATE.lastError = tostring(err)
		end
	end
	pcall(refreshHUD, dt)
end)

