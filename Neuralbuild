local function zeros(n, value)
	local out = table.create(n)
	for i = 1, n do
		out[i] = value or 0
	end
	return out
end

local function copyArray(source)
	local out = table.create(#source)
	for i = 1, #source do
		out[i] = source[i]
	end
	return out
end

local function addArrays(a, b)
	local out = table.create(#a)
	for i = 1, #a do
		out[i] = a[i] + b[i]
	end
	return out
end

local function clampArray(source, low, high)
	local out = table.create(#source)
	for i = 1, #source do
		out[i] = math.clamp(source[i], low, high)
	end
	return out
end

local function normArray(source)
	local total = 0
	for i = 1, #source do
		total += source[i] * source[i]
	end
	return math.sqrt(total + EPS)
end

local function softmax(logits)
	local maxLogit = -math.huge
	for i = 1, #logits do
		if logits[i] > maxLogit then
			maxLogit = logits[i]
		end
	end
	local out = table.create(#logits)
	local total = 0
	for i = 1, #logits do
		local value = math.exp(math.clamp(logits[i] - maxLogit, -60, 60))
		out[i] = value
		total += value
	end
	total = math.max(total, EPS)
	for i = 1, #out do
		out[i] /= total
	end
	return out
end

local function logSoftmax(logits)
	local probs = softmax(logits)
	local out = table.create(#logits)
	for i = 1, #probs do
		out[i] = math.log(math.max(probs[i], EPS))
	end
	return out
end

local function crossEntropy(logits, target)
	local probs = softmax(logits)
	local loss = 0
	for i = 1, #logits do
		if target[i] > 0 then
			loss -= target[i] * math.log(math.max(probs[i], EPS))
		end
	end
	return loss
end

local function crossEntropyGrad(logits, target)
	local probs = softmax(logits)
	local out = table.create(#logits)
	for i = 1, #logits do
		out[i] = probs[i] - target[i]
	end
	return out
end

local function twoHot(value, low, high, bins)
	local target = zeros(bins)
	local bounded = math.clamp(value, low, high)
	local position = (bounded - low) / math.max(high - low, EPS) * (bins - 1) + 1
	local lower = math.floor(position)
	local upper = math.min(lower + 1, bins)
	local fraction = position - lower
	target[lower] += 1 - fraction
	target[upper] += fraction
	return target
end

local function expectation(logits, support)
	local probs = softmax(logits)
	local result = 0
	for i = 1, #support do
		result += probs[i] * support[i]
	end
	return result
end

local function normalSample()
	local u1 = math.clamp(RNG:NextNumber(), 1e-7, 1 - 1e-7)
	local u2 = math.clamp(RNG:NextNumber(), 1e-7, 1 - 1e-7)
	return math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2)
end

local function gumbelSample()
	local u = math.clamp(RNG:NextNumber(), 1e-7, 1 - 1e-7)
	return -math.log(-math.log(u))
end

local function dotArrays(a, b)
	local total = 0
	for i = 1, #a do
		total += a[i] * b[i]
	end
	return total
end

local function cosineGrad(prediction, target)
	local predNorm = math.max(normArray(prediction), EPS)
	local targetNorm = math.max(normArray(target), EPS)
	local cosine = dotArrays(prediction, target) / (predNorm * targetNorm)
	local out = table.create(#prediction)
	for i = 1, #prediction do
		out[i] = -(target[i] / (predNorm * targetNorm) - cosine * prediction[i] / (predNorm * predNorm)) / #prediction
	end
	return cosine, out
end

local Dense = {}
Dense.__index = Dense

local function newDense(inputSize, outputSize, scale)
	local self = setmetatable({}, Dense)
	self.inputSize = inputSize
	self.outputSize = outputSize
	self.W = table.create(outputSize)
	self.gW = table.create(outputSize)
	self.vW = table.create(outputSize)
	self.b = zeros(outputSize)
	self.gb = zeros(outputSize)
	self.vb = zeros(outputSize)
	local limit = math.sqrt(2 / math.max(inputSize, 1)) * (scale or 1)
	for r = 1, outputSize do
		local row = table.create(inputSize)
		local grad = table.create(inputSize)
		local velocity = table.create(inputSize)
		for c = 1, inputSize do
			row[c] = (RNG:NextNumber() * 2 - 1) * limit
			grad[c] = 0
			velocity[c] = 0
		end
		self.W[r] = row
		self.gW[r] = grad
		self.vW[r] = velocity
	end
	PARAM_MODULES[#PARAM_MODULES + 1] = self
	return self
end

function Dense:forward(x)
	self.cache = x
	local y = table.create(self.outputSize)
	for r = 1, self.outputSize do
		local total = self.b[r]
		local row = self.W[r]
		for c = 1, self.inputSize do
			total += row[c] * x[c]
		end
		y[r] = total
	end
	return y
end

function Dense:backward(dy)
	local dx = zeros(self.inputSize)
	for r = 1, self.outputSize do
		local gradient = dy[r]
		self.gb[r] += gradient
		local row = self.W[r]
		local gradRow = self.gW[r]
		for c = 1, self.inputSize do
			gradRow[c] += gradient * self.cache[c]
			dx[c] += gradient * row[c]
		end
	end
	return dx
end

function Dense:step(learningRate)
	local lr = learningRate or CONFIG.Lr
	for r = 1, self.outputSize do
		local row = self.W[r]
		local gradRow = self.gW[r]
		local velRow = self.vW[r]
		for c = 1, self.inputSize do
			local g = math.clamp(gradRow[c], -5, 5) - CONFIG.WeightDecay * row[c]
			velRow[c] = CONFIG.Momentum * velRow[c] - lr * g
			row[c] += velRow[c]
			gradRow[c] = 0
		end
		self.vb[r] = CONFIG.Momentum * self.vb[r] - lr * math.clamp(self.gb[r], -5, 5)
		self.b[r] += self.vb[r]
		self.gb[r] = 0
	end
end

local LayerNorm = {}
LayerNorm.__index = LayerNorm

local function newLayerNorm(size)
	local self = setmetatable({}, LayerNorm)
	self.size = size
	self.gamma = zeros(size, 1)
	self.beta = zeros(size)
	self.dGamma = zeros(size)
	self.dBeta = zeros(size)
	PARAM_MODULES[#PARAM_MODULES + 1] = self
	return self
end

function LayerNorm:forward(x)
	local n = #x
	local mean = 0
	for i = 1, n do
		mean += x[i]
	end
	mean /= n
	local variance = 0
	for i = 1, n do
		local diff = x[i] - mean
		variance += diff * diff
	end
	variance /= n
	local inverse = 1 / math.sqrt(variance + 1e-5)
	local xhat = table.create(n)
	local y = table.create(n)
	for i = 1, n do
		xhat[i] = (x[i] - mean) * inverse
		y[i] = self.gamma[i] * xhat[i] + self.beta[i]
	end
	self.cacheXhat = xhat
	self.cacheInverse = inverse
	return y
end

function LayerNorm:backward(dy)
	local n = #dy
	local meanGradient = 0
	local meanGradientXhat = 0
	local scaled = table.create(n)
	for i = 1, n do
		local g = dy[i] * self.gamma[i]
		scaled[i] = g
		meanGradient += g
		meanGradientXhat += g * self.cacheXhat[i]
		self.dGamma[i] += dy[i] * self.cacheXhat[i]
		self.dBeta[i] += dy[i]
	end
	meanGradient /= n
	meanGradientXhat /= n
	local dx = table.create(n)
	for i = 1, n do
		dx[i] = self.cacheInverse * (scaled[i] - meanGradient - self.cacheXhat[i] * meanGradientXhat)
	end
	return dx
end

function LayerNorm:step(learningRate)
	local lr = learningRate or CONFIG.Lr
	for i = 1, self.size do
		self.gamma[i] = math.clamp(self.gamma[i] - lr * math.clamp(self.dGamma[i], -3, 3), 0.1, 4)
		self.beta[i] -= lr * math.clamp(self.dBeta[i], -3, 3)
		self.dGamma[i] = 0
		self.dBeta[i] = 0
	end
end

local ResBlock = {}
ResBlock.__index = ResBlock

local function newResBlock(size)
	local self = setmetatable({}, ResBlock)
	self.norm = newLayerNorm(size)
	self.first = newDense(size, size)
	self.second = newDense(size, size)
	return self
end

function ResBlock:forward(x)
	local h = self.norm:forward(x)
	self.maskFirst = table.create(#h)
	for i = 1, #h do
		if h[i] < 0 then
			h[i] = 0
			self.maskFirst[i] = 0
		else
			self.maskFirst[i] = 1
		end
	end
	h = self.first:forward(h)
	self.maskSecond = table.create(#h)
	for i = 1, #h do
		if h[i] < 0 then
			h[i] = 0
			self.maskSecond[i] = 0
		else
			self.maskSecond[i] = 1
		end
	end
	h = self.second:forward(h)
	local out = table.create(#x)
	for i = 1, #x do
		out[i] = x[i] + h[i]
	end
	return out
end

function ResBlock:backward(dy)
	local dSecond = self.second:backward(dy)
	for i = 1, #dSecond do
		dSecond[i] *= self.maskSecond[i]
	end
	local dFirst = self.first:backward(dSecond)
	for i = 1, #dFirst do
		dFirst[i] *= self.maskFirst[i]
	end
	local dNorm = self.norm:backward(dFirst)
	local dx = table.create(#dy)
	for i = 1, #dy do
		dx[i] = dy[i] + dNorm[i]
	end
	return dx
end

local RunningNorm = {}
RunningNorm.__index = RunningNorm

local function newRunningNorm(size)
	local self = setmetatable({}, RunningNorm)
	self.size = size
	self.mean = zeros(size)
	self.variance = zeros(size, 1)
	self.m2 = zeros(size)
	self.count = 1
	return self
end

function RunningNorm:forward(x)
	self.count += 1
	local out = table.create(#x)
	self.inverse = table.create(#x)
	for i = 1, #x do
		local delta = x[i] - self.mean[i]
		self.mean[i] += delta / self.count
		self.m2[i] += delta * (x[i] - self.mean[i])
		self.variance[i] = math.max(self.m2[i] / self.count, 1e-4)
		self.inverse[i] = 1 / math.sqrt(self.variance[i] + 1e-5)
		out[i] = math.clamp((x[i] - self.mean[i]) * self.inverse[i], -8, 8)
	end
	return out
end

function RunningNorm:backward(dy)
	local dx = table.create(#dy)
	for i = 1, #dy do
		dx[i] = dy[i] * self.inverse[i]
	end
	return dx
end

local function newRepresentation()
	local self = { name = "H" }
	self.norm = newRunningNorm(CONFIG.ObsDim)
	self.input = newDense(CONFIG.ObsDim, CONFIG.Hidden)
	self.normStem = newLayerNorm(CONFIG.Hidden)
	self.blocks = {}
	for i = 1, CONFIG.Blocks do
		self.blocks[i] = newResBlock(CONFIG.Hidden)
	end
	self.output = newDense(CONFIG.Hidden, CONFIG.Latent)
	self.outputNorm = newLayerNorm(CONFIG.Latent)
	function self:forward(observation)
		local x = self.norm:forward(observation)
		x = self.input:forward(x)
		x = self.normStem:forward(x)
		self.stem = table.create(#x)
		for i = 1, #x do
			self.stem[i] = math.tanh(x[i])
			x[i] = self.stem[i]
		end
		for i = 1, #self.blocks do
			x = self.blocks[i]:forward(x)
		end
		x = self.output:forward(x)
		return self.outputNorm:forward(x)
	end
	function self:backward(dy)
		local d = self.outputNorm:backward(dy)
		d = self.output:backward(d)
		for i = #self.blocks, 1, -1 do
			d = self.blocks[i]:backward(d)
		end
		for i = 1, #d do
			d[i] *= 1 - self.stem[i] * self.stem[i]
		end
		d = self.normStem:backward(d)
		d = self.input:backward(d)
		return self.norm:backward(d)
	end
	return self
end

local function newDynamics()
	local self = { name = "G" }
	self.actionNorm = newLayerNorm(CONFIG.ActionDim)
	self.embedding = newDense(CONFIG.ActionDim, CONFIG.ActionEmbed)
	self.embeddingNorm = newLayerNorm(CONFIG.ActionEmbed)
	self.input = newDense(CONFIG.Latent + CONFIG.ActionEmbed, CONFIG.Hidden)
	self.norm = newLayerNorm(CONFIG.Hidden)
	self.block = newResBlock(CONFIG.Hidden)
	self.output = newDense(CONFIG.Hidden, CONFIG.Latent)
	self.outputNorm = newLayerNorm(CONFIG.Latent)
	self.rewardHead = newDense(CONFIG.Hidden, CONFIG.RewardBins)
	function self:forward(latent, action)
		local a = self.actionNorm:forward(action)
		a = self.embedding:forward(a)
		a = self.embeddingNorm:forward(a)
		self.actionMask = table.create(#a)
		for i = 1, #a do
			if a[i] < 0 then
				a[i] = 0
				self.actionMask[i] = 0
			else
				self.actionMask[i] = 1
			end
		end
		local joined = table.create(CONFIG.Latent + CONFIG.ActionEmbed)
		for i = 1, CONFIG.Latent do
			joined[i] = latent[i]
		end
		for i = 1, CONFIG.ActionEmbed do
			joined[CONFIG.Latent + i] = a[i]
		end
		local h = self.input:forward(joined)
		h = self.norm:forward(h)
		self.hiddenMask = table.create(#h)
		for i = 1, #h do
			if h[i] < 0 then
				h[i] = 0
				self.hiddenMask[i] = 0
			else
				self.hiddenMask[i] = 1
			end
		end
		h = self.block:forward(h)
		local reward = self.rewardHead:forward(h)
		local nextLatent = self.output:forward(h)
		nextLatent = self.outputNorm:forward(nextLatent)
		nextLatent = clampArray(nextLatent, -CONFIG.LatentClamp, CONFIG.LatentClamp)
		return nextLatent, reward
	end
	function self:backward(dNextLatent, dReward)
		local dHidden = self.rewardHead:backward(dReward or zeros(CONFIG.RewardBins))
		if dNextLatent then
			local dOut = self.outputNorm:backward(dNextLatent)
			dOut = self.output:backward(dOut)
			for i = 1, #dHidden do
				dHidden[i] += dOut[i]
			end
		end
		dHidden = self.block:backward(dHidden)
		for i = 1, #dHidden do
			dHidden[i] *= self.hiddenMask[i]
		end
		local dJoined = self.norm:backward(dHidden)
		dJoined = self.input:backward(dJoined)
		local dLatent = table.create(CONFIG.Latent)
		for i = 1, CONFIG.Latent do
			dLatent[i] = dJoined[i]
		end
		local dActionEmbedded = table.create(CONFIG.ActionEmbed)
		for i = 1, CONFIG.ActionEmbed do
			dActionEmbedded[i] = dJoined[CONFIG.Latent + i]
		end
		local dEmbed = self.embeddingNorm:backward(dActionEmbedded)
		for i = 1, #dEmbed do
			dEmbed[i] *= self.actionMask[i]
		end
		dEmbed = self.embedding:backward(dEmbed)
		local dAction = self.actionNorm:backward(dEmbed)
		return dLatent, dAction
	end
	return self
end

local function newPrediction()
	local self = { name = "P" }
	self.trunk = newDense(CONFIG.Latent, CONFIG.Hidden)
	self.trunkNorm = newLayerNorm(CONFIG.Hidden)
	self.policyMean = newDense(CONFIG.Hidden, CONFIG.ActionDim)
	self.policyLogStd = newDense(CONFIG.Hidden, CONFIG.ActionDim)
	self.valueHead = newDense(CONFIG.Hidden, CONFIG.ValueBins)
	self.commandHead = newDense(CONFIG.Hidden, #Commands)
	for i = 1, CONFIG.ActionDim do
		self.policyLogStd.b[i] = -0.8
	end
	function self:forward(latent)
		local h = self.trunk:forward(latent)
		h = self.trunkNorm:forward(h)
		self.hiddenMask = table.create(#h)
		for i = 1, #h do
			if h[i] < 0 then
				h[i] = 0
				self.hiddenMask[i] = 0
			else
				self.hiddenMask[i] = 1
			end
		end
		self.hidden = h
		local mean = self.policyMean:forward(h)
		local logStd = self.policyLogStd:forward(h)
		local value = self.valueHead:forward(h)
		local command = self.commandHead:forward(h)
		return {
			mean = clampArray(mean, -1, 1),
			logStd = clampArray(logStd, -2.3, 1.2),
			value = value,
			command = command,
			latent = latent
		}
	end
	function self:backward(dMean, dLogStd, dValue, dCommand)
		local dHidden = self.commandHead:backward(dCommand or zeros(#Commands))
		local dValueHidden = self.valueHead:backward(dValue or zeros(CONFIG.ValueBins))
		local dMeanHidden = self.policyMean:backward(dMean or zeros(CONFIG.ActionDim))
		local dLogHidden = self.policyLogStd:backward(dLogStd or zeros(CONFIG.ActionDim))
		for i = 1, #dHidden do
			dHidden[i] += dValueHidden[i] + dMeanHidden[i] + dLogHidden[i]
		end
		for i = 1, #dHidden do
			dHidden[i] *= self.hiddenMask[i]
		end
		local dLatent = self.trunkNorm:backward(dHidden)
		return self.trunk:backward(dLatent)
	end
	return self
end

