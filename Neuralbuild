local function clearCreatedParts()
	local count = 0
	for part in pairs(createdParts) do
		if part and part.Parent then
			part:Destroy()
			count += 1
		end
	end
	table.clear(createdParts)
	table.clear(mutationHistory)
	return count
end

local API = {}
_G.EfficientZeroV2 = API

function API.SetProperty(instance, property, value)
	return setAnyProperty(instance, property, value)
end

function API.SpawnPart(position, options)
	return createPart(position or (STATE.position + STATE.look * 80), options)
end

function API.SetBehavior(instance, behaviorName)
	return setBehavior(instance, behaviorName)
end

function API.Mutate(commandName, action)
	local index = 1
	for i = 1, #Commands do
		if Commands[i] == commandName then
			index = i
		end
	end
	local useAction = action or STATE.lastAction
	return mutateFocus(index, useAction, senseWorld())
end

function API.Retarget(position)
	if typeof(position) == "Vector3" then
		STATE.goal = clampToWorld(position)
		STATE.lastDistance = (STATE.goal - STATE.position).Magnitude
		return STATE.goal
	end
	return nextGoal()
end

function API.SetRunning(enabled)
	STATE.running = enabled and true or false
	return STATE.running
end

function API.SetShadow(enabled)
	return setManualMode(enabled)
end

function API.SetImitationLambda(value)
	STATE.imitationLambda = math.clamp(tonumber(value) or CONFIG.ImitationLambda, 0, 1)
	return STATE.imitationLambda
end

function API.ClearCreated()
	return clearCreatedParts()
end

