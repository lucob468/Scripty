		local blueprint = state.blueprint
		local plot = state.plotPinned
		if plot and not plot.Parent then plot = nil end
		if not plot then plot = blueprint and blueprint.plot end
		if plot and plot.Parent then
			local pinned = state.plotPinned and state.plotPinned == plot
			ui.plotLabel.Text = ("%s%s · %.0f×%.0f"):format(
				pinned and "PIN " or "",
				plot.Name,
				plot.Size.X,
				plot.Size.Z
