			ui.plotLabel.TextColor3 = COLORS.text
			ui.targetDot.BackgroundColor3 = COLORS.lime
		else
			ui.plotLabel.Text = "Set / scan your build plot"
			ui.plotLabel.TextColor3 = COLORS.text
			ui.targetDot.BackgroundColor3 = COLORS.amber
		end

		if blueprint and blueprint.sourceCount > 0 then
			ui.layerLabel.Text = ("LAYER  %d / %d"):format(state.layerIndex, #blueprint.layers)
			ui.scanButton.Text = ("SCANNED · %d PARTS"):format(blueprint.sourceCount)
