			ui.pasteButton.Text = "2 · SHOW ALL · PASTE AGAIN"
			ui.pasteButton.BackgroundColor3 = COLORS.lime
			ui.pasteButton.TextColor3 = COLORS.darkText
		else
			ui.pasteButton.Text = "2 · SHOW ALL · PASTE"
			ui.pasteButton.BackgroundColor3 = COLORS.lime
			ui.pasteButton.TextColor3 = COLORS.darkText
		end

		ui.freezeButton.Text = state.pastedFrozen
			and "FREEZE PASTED: ON"
			or "FREEZE PASTED: OFF"
		ui.speedButton.Text = ("SPEED: %d"):format(state.fast and CONFIG.SPEED_FAST or CONFIG.SPEED_DEFAULT)
		ui.jetpackButton.Text = state.jetpackEnabled and "JETPACK: ON" or "JETPACK: OFF"
		ui.jetpackButton.BackgroundColor3 = state.jetpackEnabled and COLORS.blue or COLORS.panel2
		ui.pinPlotButton.Text = state.plotPinned and "PIN" or "SET"
		ui.pinPlotButton.TextColor3 = state.plotPinned and COLORS.blue or COLORS.lime
	end
	ui.update = update

	-- ========================== INTERACTION =========================
	ui.pinPlotButton.MouseButton1Click:Connect(function()
		if state.unloaded then return end
		pinPlotFromCharacter()
	end)

	ui.scanButton.MouseButton1Click:Connect(function()
		if state.pasting then notify("Wait for the paste to finish.", "warn") return end
		if state.scanning then return end
		ui.scanButton.Text = "SCANNING..."
		task.spawn(function()
			local ok, errorMessage = pcall(captureBuild)
			state.scanning = false
			if not ok then
				warn("[BuildMirror] capture failed:", errorMessage)
				notify(("Scan failed: %s"):format(tostring(errorMessage)), "error")
			end
			update()
			refreshUI()
		end)
	end)

	ui.pasteButton.MouseButton1Click:Connect(function()
		if state.pasting then
			state.cancelPaste = true
		else
			task.spawn(function()
				local ok, errorMessage = pcall(pasteAll)
				if not ok then
					warn("[BuildMirror] paste failed:", errorMessage)
					if state.pastedFolder then
						state.pastedFolder:Destroy()
					end
					state.pastedFolder = nil
					state.pastedRoot = nil
					state.pastedParts = {}
					state.pasting = false
					state.cancelPaste = false
					applyRayFilter()
					notify(("Paste failed: %s"):format(tostring(errorMessage)), "error")
				end
				refreshUI()
			end)
		end
	end)

	clearButton.MouseButton1Click:Connect(function()
		if state.pasting then
			state.cancelPaste = true
			notify("Cancelling paste...", "warn")
		else
			clearPasted(false)
		end
	end)

	ui.resetButton.MouseButton1Click:Connect(function()
		if state.pasting then state.cancelPaste = true end
		clearPreview()
		state.blueprint = nil
		state.layerIndex = 1
		notify("Capture reset. Pasted parts were left in place.", "info")
		update()
	end)

	ui.previewButton.MouseButton1Click:Connect(previewCurrentLayer)

	ui.layerUp.MouseButton1Click:Connect(function()
		local blueprint = state.blueprint
		if not blueprint or #blueprint.layers == 0 then return end
		state.layerIndex = math.min(#blueprint.layers, state.layerIndex + 1)
		if state.previewActive then drawPreview(false) end
		update()
	end)

	ui.layerDown.MouseButton1Click:Connect(function()
		local blueprint = state.blueprint
		if not blueprint or #blueprint.layers == 0 then return end
		state.layerIndex = math.max(1, state.layerIndex - 1)
		if state.previewActive then drawPreview(false) end
		update()
	end)

	ui.freezeButton.MouseButton1Click:Connect(togglePasteFreeze)
	ui.speedButton.MouseButton1Click:Connect(toggleSpeed)
	ui.jetpackButton.MouseButton1Click:Connect(toggleJetpack)
	ui.collapse.MouseButton1Click:Connect(function()
		state.uiCollapsed = not state.uiCollapsed
		ui.body.Visible = not state.uiCollapsed
		ui.subtitle.Visible = not state.uiCollapsed
		ui.main.Size = state.uiCollapsed and UDim2.fromOffset(254, 48) or UDim2.fromOffset(254, 574)
		ui.collapse.Text = state.uiCollapsed and "+" or "_"
	end)
	ui.unloadButton.MouseButton1Click:Connect(function()
		unload()
	end)

	-- Drag the header (works with mouse + touch).
	local dragging, dragStart, startPosition = false, nil, nil
	local function beginDrag(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPosition = ui.main.Position
		end
	end
	ui.dragRegion.InputBegan:Connect(beginDrag)
	addConnection(UserInputService.InputChanged:Connect(function(input)
		if dragging and dragStart and startPosition
			and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			ui.main.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,
				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)
		end
	end))
	addConnection(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	-- Scaling keeps the panel usable on phones and small Studio viewports.
	local function updateScale()
		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
		local target = math.clamp(viewport.Y / 760, 0.72, 1.05)
		ui.scale.Scale = target
	end
	addConnection(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(updateScale))
	if workspace.CurrentCamera then
		addConnection(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale))
	end
	updateScale()
	addLog("Ready. Press 1 · SCAN BUILD to capture.", "info")
	addLog("Paste now fits the whole build and keeps block configs.", "info")
	update()
	return update
end

-- Forward declarations used by capture/paste handlers.
function notify(text, tone)
	if ui.addLog then
		ui.addLog(text, tone)
	end
end

function refreshUI()
	if ui.update then ui.update() end
end

function unload()
	if state.unloaded then return end
	state.unloaded = true
	state.cancelPaste = true
	stopJetpackVisuals()
	if state.previewFolder then state.previewFolder:Destroy() end
	if state.pastedFolder then state.pastedFolder:Destroy() end
	if hum and hum.Parent then hum.WalkSpeed = CONFIG.SPEED_DEFAULT end
	for _, connection in ipairs(state.connections) do
		pcall(function() connection:Disconnect() end)
	end
	if ui.screenGui then ui.screenGui:Destroy() end
	state.jetpackEnabled = false
	state.blueprint = nil
	state.pastedParts = {}
	state.pastedRoot = nil
	state.pastedFolder = nil
	state.plotPinned = nil
	state.pastedFrozen = true
end

local updateUI = createUI()
refreshUI = function() updateUI() end
-- createUI assigns the real notify; make sure startup messages are visible.
refreshUI()

local uiVisible = true
addConnection(UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == CONFIG.KEY_TOGGLE_UI then
		uiVisible = not uiVisible
		if ui.screenGui then ui.screenGui.Enabled = uiVisible end
		return
	end
	if processed or state.unloaded then return end
	if UserInputService:GetFocusedTextBox() then return end

	if input.KeyCode == CONFIG.KEY_JETPACK then
		toggleJetpack()
		return
	end
	if not state.jetpackEnabled then return end
	if input.KeyCode == CONFIG.KEY_UP then state.upPressed = true end
	if input.KeyCode == CONFIG.KEY_DOWN then state.downPressed = true end
end))

addConnection(UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == CONFIG.KEY_UP then state.upPressed = false end
	if input.KeyCode == CONFIG.KEY_DOWN then state.downPressed = false end
end))

addConnection(RunService.Heartbeat:Connect(function(deltaTime)
	if state.unloaded then return end
	local ok, errorMessage = pcall(updateJetpack, deltaTime)
	if not ok then
		warn("[BuildMirror] jetpack update failed:", errorMessage)
		state.jetpackEnabled = false
		stopJetpackVisuals()
		refreshUI()
	end
end))

-- Refresh the target card occasionally so respawns / plot changes are noticed.
task.spawn(function()
	while not state.unloaded do
		task.wait(1)
		if not state.pasting and not state.blueprint then
			refreshUI()
		end
	end
end)

print("[BuildMirror v2.1] loaded — whole-build paste, block configs preserved. SET pins your plot.")
